{
  "$id": "buf.protoschema.test.v1.CustomVendor.schema.strict.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A vendor whose schema is customized.",
  "entity": "user",
  "properties": {
    "name": {
      "type": "string",
      "x-example": "alice"
    },
    "price": {
      "default": 5,
      "description": "The price in cents.",
      "maximum": 2147483647,
      "minimum": -2147483648,
      "title": "Price",
      "type": "integer"
    }
  },
  "required": [
    "name",
    "price"
  ],
  "tags": [
    "a",
    "b"
  ],
  "title": "A Custom Vendor",
  "type": "object"
}
